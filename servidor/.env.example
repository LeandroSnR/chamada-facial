# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env (já está no .gitignore).

# Chave secreta que o cliente deve enviar no header X-API-Key
API_KEY=troque-por-uma-chave-secreta-forte

# Porta em que o servidor FastAPI vai escutar
PORT=8000

# Duração da janela de chamada em minutos
JANELA_CHAMADA_MINUTOS=15

# Threshold de distância para considerar match (menor = mais exigente)
# Valores típicos com face_recognition: 0.5 a 0.6
THRESHOLD_RECONHECIMENTO=0.55

# Caminho do banco de encodings e do banco de presenças
CAMINHO_ENCODINGS=dados/encodings/
CAMINHO_DB=dados/db/presencas.db
