# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env (já está no .gitignore).

# URL do servidor de processamento (IP do Tailscale ou domínio do tunnel)
SERVIDOR_URL=http://100.x.x.x:8000

# Mesma chave configurada no servidor
API_KEY=troque-por-uma-chave-secreta-forte

# Identificação da turma capturada por essa câmera
TURMA_ID=9A

# Índice da câmera no OpenCV (geralmente 0 para webcam padrão)
CAMERA_INDEX=0

# Intervalo entre capturas de frame, em segundos
INTERVALO_CAPTURA_SEGUNDOS=2.5
